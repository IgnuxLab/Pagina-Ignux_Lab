---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutUs from '../components/AboutUs.astro';
import HowWeDoIt from '../components/HowWeDoIt.astro';

import '../assets/styles/components/about.css';
import '../assets/styles/components/team-section.css';
---

<Layout title="Sobre Nosotros">
	<div class="page-container">
		<Header />
		
		<main class="about-main">
			<section class="hero-banner">
				<div class="hero-content">
					<h1 class="hero-title">Sobre IgnuxLab</h1>
					<div class="breadcrumb">
						<a href={`${import.meta.env.BASE_URL}`} class="breadcrumb-link">Inicio</a>
						<span class="separator">/</span>
						<span class="breadcrumb-active">Sobre Nosotros</span>
					</div>
				</div>
			</section>

			<!-- Componentes separados -->
			<AboutUs />
			<div class="section-separator"></div>
			<HowWeDoIt />
			<div class="section-separator"></div>
        
        <!-- Sección de Equipo -->
        <section class="team-section section-spacing section-depth">
            <div class="team-container">
                                    <div class="team-header">
                        <h2 class="team-main-title">Equipo de trabajo</h2>
                        <p class="team-subtitle">Personas creativas, comprometidas y apasionadas que hacen posible cada proyecto en IGNUX Lab</p>
                    </div>
                
                <div class="team-grid">
                    <!-- Fabian Ricardo Caro Aponte - Socio Fundador -->
                    <div class="team-card">

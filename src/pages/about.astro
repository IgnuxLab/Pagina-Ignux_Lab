                                            <span class="skill-tag">Arte</span>
                                            <span class="skill-tag">Marketing Digital</span>
                                            <span class="skill-tag">Audiovisual</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="team-banner">
                            <h4 class="banner-name">Sofía Hurtado Montes</h4>
                            <p class="banner-role">
                                <svg class="role-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21h6"/>

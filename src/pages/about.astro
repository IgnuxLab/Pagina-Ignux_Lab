<script>
    /**
     * Team Toggle Functionality
     */
    document.addEventListener('DOMContentLoaded', function() {
        const teamCards = document.querySelectorAll('.team-card');
        
        // Toggle team card overlay
        function toggleTeamCard(card: Element) {
            console.log('Toggling card:', card); // Debug
            
            // Close all other active cards first
            teamCards.forEach(otherCard => {
                if (otherCard !== card) {
                    otherCard.classList.remove('active');
                }
            });
            
            // Toggle current card
            const isActive = card.classList.contains('active');
            if (isActive) {
                card.classList.remove('active');
                console.log('Removed active class'); // Debug
            } else {
                card.classList.add('active');
                console.log('Added active class'); // Debug
            }
        }
        
        // Add click event listeners to team cards
        teamCards.forEach((card, index) => {
            const imageContainer = card.querySelector('.team-image-container');
            const banner = card.querySelector('.team-banner');
            
            console.log(`Setting up card ${index}`); // Debug
            
            // Click on image container
            if (imageContainer) {
                imageContainer.addEventListener('click', function(e) {
                    console.log('Image clicked on card', index); // Debug
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTeamCard(card);
                });
                
                // Always add cursor pointer for mobile
                (imageContainer as HTMLElement).style.cursor = 'pointer';
            }
            
            // Click on banner
            if (banner) {
                banner.addEventListener('click', function(e) {
                    console.log('Banner clicked on card', index); // Debug
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTeamCard(card);
                });
                
                // Always add cursor pointer for mobile
                (banner as HTMLElement).style.cursor = 'pointer';
            }
        });
        
        // Close overlay when clicking outside (only on mobile screens)
        document.addEventListener('click', function(e) {
            if (window.innerWidth > 768) return; // Only on mobile
            
            const target = e.target as HTMLElement;
            const clickedCard = target?.closest('.team-card');
            if (!clickedCard) {
                console.log('Clicking outside, closing all'); // Debug
                teamCards.forEach(card => {
                    card.classList.remove('active');
                });
            }
        });
        
        console.log('Team toggle initialized with', teamCards.length, 'cards'); // Debug
    });
</script>

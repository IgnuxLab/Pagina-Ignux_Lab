---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AboutUs from "../components/AboutUs.astro";
import HowWeDoIt from "../components/HowWeDoIt.astro";

import "../assets/styles/components/about.css";
import "../assets/styles/components/team-section.css";
---

<Layout title="Sobre Nosotros">
  <div class="page-container">
    <Header />

    <main class="about-main">
      <section class="hero-banner">
        <div class="hero-content">
          <h1 class="hero-title">Sobre IgnuxLab</h1>
          <div class="breadcrumb">
            <a href={`${import.meta.env.BASE_URL}`} class="breadcrumb-link"
              >Inicio</a
            >
            <span class="separator">/</span>
            <span class="breadcrumb-active">Sobre Nosotros</span>
          </div>
        </div>
      </section>

      <!-- Componentes separados -->
      <AboutUs />
      <div class="section-separator"></div>
      <HowWeDoIt />
      <div class="section-separator"></div>

      <!-- Sección de Equipo -->
      <section class="team-section section-spacing section-depth">
        <div class="team-container">
          <div class="team-header">
            <h2 class="team-main-title">Equipo de trabajo</h2>
            <p class="team-subtitle">
              Personas creativas, comprometidas y apasionadas que hacen posible
              cada proyecto en IGNUX Lab
            </p>
          </div>

          <div class="team-grid">
            <!-- Fabian Ricardo Caro Aponte - Socio Fundador -->
            <div class="team-card">
              <div class="team-image-container">
                <img
                  src={`${import.meta.env.BASE_URL}img/equipo/Fabian-Caro.webp`}
                  alt="Fabian Ricardo Caro Aponte"
                  class="team-image"
                />
                <div class="team-overlay">
                  <div class="overlay-content">
                    <div class="overlay-header">
                      <h4 class="overlay-name">Fabian Ricardo Caro Aponte</h4>
                      <p class="overlay-role">
                        <svg
                          class="role-icon"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                          ></path>
                        </svg>
                        Socio Fundador
                      </p>
                    </div>
                    <div class="overlay-info">
                      <p class="overlay-description">
                        Información próximamente...
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Fabian Ricardo Caro Aponte</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                    ></path>
                  </svg>
                  Socio Fundador
                </p>
              </div>
            </div>

            <!-- Hemmes - Socio -->
            <div class="team-card">
              <div class="team-image-container">
                <img
                  src={`${import.meta.env.BASE_URL}img/equipo/Hemmes.webp`}
                  alt="Hemmes"
                  class="team-image"
                />
                <div class="team-overlay">
                  <div class="overlay-content">
                    <div class="overlay-header">
                      <h4 class="overlay-name">Hemmes Homes SAS</h4>
                      <p class="overlay-role">
                        <svg
                          class="role-icon"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                          ></path>
                          <circle cx="8.5" cy="7" r="4"></circle>
                          <path d="M20 8v6M23 11h-6"></path>
                        </svg>
                        Socio
                      </p>
                    </div>
                    <div class="overlay-info">
                      <p class="overlay-description">
                        Información próximamente...
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Hemmes Homes SAS</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <path d="M20 8v6M23 11h-6"></path>
                  </svg>

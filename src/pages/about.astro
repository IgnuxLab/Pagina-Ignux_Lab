<script>
    /**
     * Team Toggle Functionality & Detail Modal
     */
    document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM Content Loaded - initializing team functionality'); // Debug
        
        const teamCards = document.querySelectorAll('.team-card');
        const modal = document.querySelector('#teamModal');
        const modalContent = document.querySelector('.team-modal-content');
        const closeBtn = document.querySelector('.team-modal-close');
        const backdrop = document.querySelector('.team-modal-backdrop');
        
        console.log('Found elements:', {
            teamCards: teamCards.length,
            modal: !!modal,
            modalContent: !!modalContent,
            closeBtn: !!closeBtn,
            backdrop: !!backdrop
        }); // Debug
        
        // Información detallada de los miembros del equipo
        const teamData = {
            sofia: {
                name: "Sofía Hurtado Montes",
                role: "Gerente Laboratorio Creativo",
                image: "Sofia-Hurtado.webp",
                fullBio: "Graduada del pregrado en Arte de la Universidad de los Andes, con opción en Escritura Creativa. Magíster en Artes Plásticas, Electrónicas y del Tiempo de la misma institución. Ha complementado su formación con cursos de actualización en universidades de París y del Reino Unido. Cuenta con seis años de experiencia en comunicaciones, marketing digital y proyectos audiovisuales.",
                education: [
                    "Pregrado en Arte - Universidad de los Andes",
                    "Opción en Escritura Creativa",
                    "Magíster en Artes Plásticas, Electrónicas y del Tiempo - Universidad de los Andes",
                    "Cursos de actualización - Universidades de París y Reino Unido"
                ],
                experience: "6 años",
                specialties: ["Comunicaciones", "Marketing Digital", "Proyectos Audiovisuales", "Arte", "Escritura Creativa"]
            },
            alexander: {
                name: "Alexander Narváez",
                role: "Gerente Laboratorio de Proyectos",
                image: "Alexander-Narvaez.webp",
                fullBio: "Ingeniero industrial con más de 15 años de experiencia en la dirección de proyectos financiados con recursos públicos, especialmente del Sistema General de Regalías (SGR). Especialista en Gestión de Proyectos de Ingeniería y Magíster en Gobierno y Políticas Públicas. Se ha desempeñado como gerente, asesor, coordinador y profesional de seguimiento en entidades y proyectos de alto impacto en desarrollo regional, innovación, ciencia y tecnología. Cuenta con amplia experiencia en procesos de interventoría, formulación, seguimiento y evaluación de proyectos públicos.",
                education: [
                    "Ingeniería Industrial",
                    "Especialista en Gestión de Proyectos de Ingeniería",
                    "Magíster en Gobierno y Políticas Públicas"
                ],
                experience: "15+ años",
                specialties: ["Gestión de Proyectos SGR", "Políticas Públicas", "Desarrollo Regional", "Innovación", "Ciencia y Tecnología", "Interventoría", "Evaluación de Proyectos"]
            },
            camilo: {
                name: "Camilo Castro",
                role: "Gerente General",
                image: "Camilo_Castro.webp",
                fullBio: "Ingeniero con especialización y maestría en Gerencia, apasionado por el liderazgo de equipos de alto desempeño. Con más de 20 años de trayectoria, ha impulsado la innovación en los sectores público y privado, generando resultados de alto impacto.",
                education: [
                    "Ingeniería",
                    "Especialización en Gerencia",
                    "Maestría en Gerencia"
                ],
                experience: "20+ años",
                specialties: ["Liderazgo", "Equipos de Alto Desempeño", "Innovación", "Gestión Empresarial", "Sector Público", "Sector Privado"]
            },
            daniela: {
                name: "Daniela Arango Sánchez",
                role: "Gerente Administrativo",
                image: "Daniela-Arango.webp",
                fullBio: "Administradora de Empresas con más de cuatro años de experiencia en la gestión de procesos administrativos y de recursos humanos en los sectores educativo y tecnológico. Ha complementado su formación con estudios en inteligencia de negocios y en sistemas de gestión de calidad, lo que le ha permitido fortalecer y optimizar procesos organizacionales.",
                education: [
                    "Administración de Empresas",
                    "Estudios en Inteligencia de Negocios",
                    "Sistemas de Gestión de Calidad"
                ],
                experience: "4+ años",
                specialties: ["Procesos Administrativos", "Recursos Humanos", "Sector Educativo", "Sector Tecnológico", "Inteligencia de Negocios", "Gestión de Calidad"]
            }
        };
        
        // Toggle team card overlay
        function toggleTeamCard(card: Element) {
            console.log('Toggling card:', card); // Debug
            
            // Close all other active cards first
            teamCards.forEach(otherCard => {
                if (otherCard !== card) {
                    otherCard.classList.remove('active');
                }
            });
            
            // Toggle current card
            const isActive = card.classList.contains('active');
            if (isActive) {
                card.classList.remove('active');
                console.log('Removed active class'); // Debug
            } else {
                card.classList.add('active');
                console.log('Added active class'); // Debug
            }
        }
        
        // Abrir modal con información detallada
        function openDetailModal(memberId: string) {
            console.log('Opening modal for:', memberId); // Debug
            const member = (teamData as any)[memberId];
            if (!member) {
                console.error('Member not found:', memberId);
                return;
            }
            
            // Usar la misma lógica de rutas que en las tarjetas
            const baseUrl = import.meta.env.BASE_URL || '';
            const imgSrc = `${baseUrl}img/equipo/${member.image}`;
            
            const modalHTML = `
                <div class="modal-header">
                    <div class="modal-avatar">
                        <img src="${imgSrc}" alt="${member.name}" />
                    </div>
                    <div class="modal-title-section">
                        <h3 class="modal-name">${member.name}</h3>
                        <p class="modal-role">${member.role}</p>
                        <div class="modal-experience">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
                            </svg>
                            <span>${member.experience} de experiencia</span>
                        </div>
                    </div>
                </div>
                
                <div class="modal-body">
                    <div class="modal-section">
                        <h4 class="section-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14,2 14,8 20,8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <polyline points="10,9 9,9 8,9"/>
                            </svg>
                            Perfil Profesional
                        </h4>
                        <p class="bio-text">${member.fullBio}</p>
                    </div>
                    
                    <div class="modal-section">
                        <h4 class="section-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                            </svg>
                            Formación Académica
                        </h4>
                        <ul class="education-list">
                            ${member.education.map((edu: any) => `
                                <li class="education-item">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20,6 9,17 4,12"/>
                                    </svg>
                                    ${edu}
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                    
                    <div class="modal-section">
                        <h4 class="section-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            Especialidades
                        </h4>
                        <div class="specialties-grid">
                            ${member.specialties.map((specialty: any) => `
                                <span class="specialty-tag">${specialty}</span>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
            
            if (modalContent) {
                modalContent.innerHTML = modalHTML;
                console.log('Modal content set');
            } else {
                console.error('Modal content element not found');
                return;
            }
            
            if (modal) {
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                console.log('Modal opened, classes:', modal.className);
                
                // Force reflow para asegurar que se apliquen los estilos
                modal.offsetHeight;
                
                // Verificar si el modal es visible
                setTimeout(() => {
                    const computedStyle = window.getComputedStyle(modal);
                    console.log('Modal display:', computedStyle.display);
                    console.log('Modal opacity:', computedStyle.opacity);
                    console.log('Modal z-index:', computedStyle.zIndex);
                }, 100);
            } else {
                console.error('Modal element not found');
            }
        }
        
        // Cerrar modal
        function closeDetailModal() {
            modal?.classList.remove('is-open');
            modal?.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }
        
        // Event listeners para las tarjetas del equipo
        teamCards.forEach((card, index) => {
            const imageContainer = card.querySelector('.team-image-container');
            const banner = card.querySelector('.team-banner');
            
            console.log(`Setting up card ${index}`); // Debug
            
            // Click on image container
            if (imageContainer) {
                imageContainer.addEventListener('click', function(e) {
                    console.log('Image clicked on card', index); // Debug
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTeamCard(card);
                });
                
                // Always add cursor pointer for mobile
                (imageContainer as HTMLElement).style.cursor = 'pointer';
            }
            
            // Click on banner
            if (banner) {
                banner.addEventListener('click', function(e) {
                    console.log('Banner clicked on card', index); // Debug
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTeamCard(card);
                });
                
                // Always add cursor pointer for mobile
                (banner as HTMLElement).style.cursor = 'pointer';
            }
        });
        
        // Event listeners para los botones "Ver más detalles"
        document.addEventListener('click', function(e) {
            console.log('Document click detected on:', e.target); // Debug
            
            const detailBtn = (e.target as HTMLElement).closest('.team-info-btn');
            if (detailBtn) {
                console.log('Detail button clicked:', detailBtn); // Debug
                e.preventDefault();
                e.stopPropagation();
                const memberId = detailBtn.getAttribute('data-member');
                console.log('Member ID:', memberId); // Debug
                if (memberId) {
                    openDetailModal(memberId);
                }
                return;
            }
            
            // Cerrar modal
            if ((e.target as HTMLElement).closest('.team-modal-close') || 
                (e.target as HTMLElement).classList.contains('team-modal-backdrop')) {
                console.log('Close modal clicked'); // Debug
                closeDetailModal();
                return;
            }
            
            // Close overlay when clicking outside (only on mobile screens)
            if (window.innerWidth > 768) return; // Only on mobile
            
            const target = e.target as HTMLElement;
            const clickedCard = target?.closest('.team-card');
            if (!clickedCard) {
                console.log('Clicking outside, closing all'); // Debug
                teamCards.forEach(card => {
                    card.classList.remove('active');
                });
            }
        });
        
        // Cerrar modal con Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
                closeDetailModal();
            }
        });
        
        // Event listeners adicionales para los botones de detalles
        const detailButtons = document.querySelectorAll('.team-info-btn');
        console.log('Found detail buttons:', detailButtons.length); // Debug
        
        detailButtons.forEach((button, index) => {
            console.log(`Setting up button ${index}:`, button); // Debug
            button.addEventListener('click', function(e) {
                console.log('Direct button click event:', this); // Debug
                e.preventDefault();
                e.stopPropagation();
                const memberId = this.getAttribute('data-member');
                console.log('Member ID from button:', memberId); // Debug
                if (memberId) {
                    openDetailModal(memberId);
                }
            });
        });
        
        console.log('Team toggle and modal initialized with', teamCards.length, 'cards'); // Debug
        
        // Test modal después de 2 segundos para debug
        setTimeout(() => {
            console.log('Testing modal functionality...'); // Debug
            const testButton = document.querySelector('[data-member="sofia"]');
            if (testButton) {
                console.log('Found Sofia button:', testButton); // Debug
            } else {
                console.log('Sofia button not found'); // Debug
            }
        }, 2000);
        
        // Función global para testing
        (window as any).testModal = function(memberId: string) {
            console.log('Manual test for member:', memberId);
            openDetailModal(memberId);
        };
        
        (window as any).checkModal = function() {
            console.log('Modal element:', modal);
            console.log('Modal content:', modalContent);
            console.log('Modal classes:', modal?.className);
        };
    });
</script>

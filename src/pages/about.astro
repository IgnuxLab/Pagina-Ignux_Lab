                        experiencia.
                      </p>
                      <button class="view-more-btn" data-member="camilo" aria-label="Ver perfil completo">
                        <span>Ver más</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Camilo Castro</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                    <path d="M12 14v7"></path>
                    <path d="M8 17l8 0"></path>
                    <path d="M10 15l4 0"></path>
                  </svg>
                  Gerente General
                </p>
              </div>
            </div>

            <!-- Alexander Narváez - Gerente Laboratorio de Proyectos -->
            <div class="team-card">
              <div class="team-image-container">
                <img
                  src={`${import.meta.env.BASE_URL}img/equipo/Alexander_Narvaez.webp`}
                  alt="Alexander Narváez"
                  class="team-image"
                />
                <div class="team-overlay">
                  <div class="overlay-content">
                    <div class="overlay-header">
                      <h4 class="overlay-name">Alexander Narváez</h4>
                      <p class="overlay-role">
                        <svg
                          class="role-icon"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <polyline points="16,18 22,12 16,6"></polyline>
                          <polyline points="8,6 2,12 8,18"></polyline>
                        </svg>
                        Gerente Laboratorio de Proyectos
                      </p>
                    </div>
                    <div class="overlay-info">
                      <p class="overlay-description" data-member="alexander">
                        Ingeniero industrial con más de 15 años de experiencia
                        en dirección de proyectos públicos y desarrollo
                        regional.
                      </p>
                      <button class="view-more-btn" data-member="alexander" aria-label="Ver perfil completo">
                        <span>Ver más</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Alexander Narváez</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="16,18 22,12 16,6"></polyline>
                    <polyline points="8,6 2,12 8,18"></polyline>
                  </svg>
                  Gerente Laboratorio de Proyectos
                </p>
              </div>
            </div>

            <!-- Sofía Hurtado Montes - Gerente Laboratorio Creativo -->
            <div class="team-card">
              <div class="team-image-container">
                <img
                  src={`${import.meta.env.BASE_URL}img/equipo/Sofia-Hurtado.webp`}
                  alt="Sofia Hurtado Montes"
                  class="team-image"
                />
                <div class="team-overlay">
                  <div class="overlay-content">
                    <div class="overlay-header">
                      <h4 class="overlay-name">Sofía Hurtado Montes</h4>
                      <p class="overlay-role">
                        <svg
                          class="role-icon"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M9 21h6"></path>
                          <path d="M12 17h0"></path>
                          <path
                            d="M12 3a6 6 0 0 0-6 6c0 1 1 2 1 3h10c0-1 1-2 1-3a6 6 0 0 0-6-6z"
                          ></path>
                          <path d="M8 19h8"></path>
                        </svg>
                        Gerente Laboratorio Creativo
                      </p>
                    </div>
                    <div class="overlay-info">
                      <p class="overlay-description" data-member="sofia">
                        Graduada en Arte de la Universidad de los Andes con
                        especialización en comunicaciones, marketing digital y
                        proyectos audiovisuales.
                      </p>
                      <button class="view-more-btn" data-member="sofia" aria-label="Ver perfil completo">
                        <span>Ver más</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Sofía Hurtado Montes</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 21h6"></path>
                    <path d="M12 17h0"></path>
                    <path
                      d="M12 3a6 6 0 0 0-6 6c0 1 1 2 1 3h10c0-1 1-2 1-3a6 6 0 0 0-6-6z"
                    ></path>
                    <path d="M8 19h8"></path>
                  </svg>
                  Gerente Laboratorio Creativo
                </p>
              </div>
            </div>

            <!-- Daniela Arango Sánchez - Gerente Administrativa y Financiera -->
            <div class="team-card centered">
              <div class="team-image-container">
                <img
                  src={`${import.meta.env.BASE_URL}img/equipo/Daniela-Arango.webp`}
                  alt="Daniela Arango Sánchez"
                  class="team-image"
                />
                <div class="team-overlay">
                  <div class="overlay-content">
                    <div class="overlay-header">
                      <h4 class="overlay-name">Daniela Arango Sánchez</h4>
                      <p class="overlay-role">
                        <svg
                          class="role-icon"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                          ></path>
                          <circle cx="9" cy="7" r="4"></circle>
                          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        Gerente Administrativa y Financiera
                      </p>
                    </div>
                    <div class="overlay-info">
                      <p class="overlay-description" data-member="daniela">
                        Administradora de Empresas con más de cuatro años de
                        experiencia en gestión de procesos administrativos y
                        recursos humanos.
                      </p>
                      <button class="view-more-btn" data-member="daniela" aria-label="Ver perfil completo">
                        <span>Ver más</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-banner">
                <h4 class="banner-name">Daniela Arango Sánchez</h4>
                <p class="banner-role">
                  <svg
                    class="role-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  Gerente Administrativa y Financiera
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Modal de Información del Equipo -->
      <div id="teamModal" class="team-modal" aria-hidden="true">
        <div class="team-modal-backdrop"></div>
        <div class="team-modal-dialog" role="dialog" aria-modal="true">
          <button class="team-modal-close" type="button" aria-label="Cerrar">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div class="team-modal-content">
            <!-- Contenido dinámico se insertará aquí -->
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  /**
   * Team Toggle Functionality & Detail Modal
   */
  document.addEventListener("DOMContentLoaded", function () {
    const teamCards = document.querySelectorAll(".team-card");
    const modal = document.querySelector("#teamModal");
    const modalContent = document.querySelector(".team-modal-content");
    const closeBtn = document.querySelector(".team-modal-close");
    const backdrop = document.querySelector(".team-modal-backdrop");

    // Información detallada de los miembros del equipo
    const teamData = {
      sofia: {
        name: "Sofía Hurtado Montes",
        role: "Gerente Laboratorio Creativo",
        image: "Sofia-Hurtado.webp",
        fullBio:
          "Graduada del pregrado en Arte de la Universidad de los Andes, con opción en Escritura Creativa. Magíster en Artes Plásticas, Electrónicas y del Tiempo de la misma institución. Ha complementado su formación con cursos de actualización en universidades de París y del Reino Unido. Cuenta con siete años de experiencia en comunicaciones, marketing digital y proyectos audiovisuales.",
        education: [
          "Pregrado en Arte - Universidad de los Andes",
          "Opción en Escritura Creativa",
          "Magíster en Artes Plásticas, Electrónicas y del Tiempo - Universidad de los Andes",
          "Cursos de actualización - Universidades de París y Reino Unido",
        ],
        experience: "7 años",
        specialties: [
          "Comunicaciones",
          "Marketing Digital",
          "Proyectos Audiovisuales",
          "Arte",
          "Escritura Creativa",
        ],
      },
      alexander: {
        name: "Alexander Narváez",
        role: "Gerente Laboratorio de Proyectos",
        image: "Alexander_Narvaez.webp",
        fullBio:
          "Especialista en Gestión de Proyectos de Ingeniería y Magíster en Gobierno y Políticas Públicas. Ingeniero industrial con más de 15 años de experiencia en la dirección de proyectos financiados con recursos públicos, especialmente del Sistema General de Regalías (SGR). Se ha desempeñado como gerente, asesor, coordinador y profesional de seguimiento en entidades y proyectos de alto impacto en desarrollo regional, innovación, ciencia y tecnología. Cuenta con amplia experiencia en procesos de interventoría, formulación, seguimiento y evaluación de proyectos públicos.",
        education: [
          "Ingeniería Industrial",
          "Especialista en Gestión de Proyectos de Ingeniería",
          "Magíster en Gobierno y Políticas Públicas",
        ],
        experience: "15+ años",
        specialties: [
          "Gestión de Proyectos SGR",
          "Políticas Públicas",
          "Desarrollo Regional",
          "Innovación",
          "Ciencia y Tecnología",
          "Interventoría",
          "Evaluación de Proyectos",
        ],
      },
      camilo: {
        name: "Camilo Castro",
        role: "Gerente General",
        image: "Camilo-Castro.webp",
        fullBio:
          "Ingeniero con especialización y maestría en Gerencia, apasionado por el liderazgo de equipos de alto desempeño. Con más de 20 años de trayectoria, ha impulsado la innovación en los sectores público y privado, generando resultados de alto impacto.",
        education: [
          "Ingeniería",
          "Especialización en Gerencia",
          "Maestría en Gerencia",
        ],
        experience: "20+ años",
        specialties: [
          "Liderazgo",
          "Equipos de Alto Desempeño",
          "Innovación",
          "Gestión Empresarial",
          "Sector Público",
          "Sector Privado",
        ],
      },
      daniela: {
        name: "Daniela Arango Sánchez",
        role: "Gerente Administrativa y Financiera",
        image: "Daniela-Arango.webp",
        fullBio:
          "Administradora de Empresas con más de cuatro años de experiencia en la gestión de procesos administrativos y de recursos humanos en los sectores educativo y tecnológico. Ha complementado su formación con estudios en inteligencia de negocios y en sistemas de gestión de calidad, lo que le ha permitido fortalecer y optimizar procesos organizacionales.",
        education: [
          "Administración de Empresas",
          "Estudios en Inteligencia de Negocios",
          "Sistemas de Gestión de Calidad",
        ],
        experience: "4+ años",
        specialties: [
          "Procesos Administrativos",
          "Recursos Humanos",
          "Sector Educativo",
          "Sector Tecnológico",
          "Inteligencia de Negocios",
          "Gestión de Calidad",
        ],
      },
    };

    // Toggle team card overlay
    function toggleTeamCard(card: Element) {
      // Close all other active cards first
      teamCards.forEach((otherCard) => {
        if (otherCard !== card) {
          otherCard.classList.remove("active");
        }
      });

      // Toggle current card
      const isActive = card.classList.contains("active");
      if (isActive) {
        card.classList.remove("active");
      } else {
        card.classList.add("active");
      }
    }

    // Abrir modal con información detallada
    function openDetailModal(memberId: string) {
      const member = (teamData as any)[memberId];
      if (!member) {
        console.error("Member not found:", memberId);
        return;
      }

      // Usar la misma lógica de rutas que en las tarjetas
      const baseUrl = import.meta.env.BASE_URL || "";
      const imgSrc = `${baseUrl}img/equipo/${member.image}`;

      const modalHTML = `
                <div class="modal-header">
                    <div class="modal-avatar">
                        <img src="${imgSrc}" alt="${member.name}" />
                    </div>
                    <div class="modal-title-section">
                        <h3 class="modal-name">${member.name}</h3>
                        <p class="modal-role">${member.role}</p>
                        <div class="modal-experience">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/>
                            </svg>
                            <span>${member.experience} de experiencia</span>
                        </div>
                    </div>
                </div>
                
                <div class="modal-body">
                    <div class="modal-section">
                        <h4 class="section-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14,2 14,8 20,8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <polyline points="10,9 9,9 8,9"/>
                            </svg>
                            Perfil Profesional
                        </h4>
                        <p class="bio-text">${member.fullBio}</p>
                    </div>
                    
                    
                    <div class="modal-section">
                        <h4 class="section-title">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            Especialidades
                        </h4>
                        <div class="specialties-grid">
                            ${member.specialties
                              .map(
                                (specialty: any) => `
                                <span class="specialty-tag">${specialty}</span>
                            `,
                              )
                              .join("")}
                        </div>
                    </div>
                </div>
            `;

      if (modalContent) {
        modalContent.innerHTML = modalHTML;
      } else {
        console.error("Modal content element not found");
        return;
      }

      if (modal) {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        // Force reflow para asegurar que se apliquen los estilos
        (modal as HTMLElement).offsetHeight;
      } else {
        console.error("Modal element not found");
      }
    }

    // Cerrar modal
    function closeDetailModal() {
      modal?.classList.remove("is-open");
      modal?.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    // Cargar fullBio completo en el overlay al hacer hover
    function loadFullBioOnHover() {
      const descriptions = document.querySelectorAll('.overlay-description[data-member]');
      
      descriptions.forEach((description) => {
        const memberId = (description as HTMLElement).getAttribute('data-member');
        if (!memberId) return;
        
        const member = (teamData as any)[memberId];
        if (!member || !member.fullBio) return;
        
        const card = description.closest('.team-card');
        if (!card) return;
        
        // Cargar el fullBio completo cuando se hace hover
        card.addEventListener('mouseenter', () => {
          (description as HTMLElement).textContent = member.fullBio;
          description.classList.add('full-bio-loaded');
        });
      });
    }

    // Inicializar carga de fullBio
    loadFullBioOnHover();

    // Event listeners para botones "Ver más" - debe ejecutarse primero
    document.addEventListener('click', (e) => {
      const viewMoreBtn = (e.target as HTMLElement).closest('.view-more-btn');
      if (viewMoreBtn) {
        e.preventDefault();
        e.stopPropagation();
        const memberId = viewMoreBtn.getAttribute('data-member');
        if (memberId) {
          openDetailModal(memberId);
        }
        return false;
      }
    }, true); // Usar capture phase para ejecutarse primero

    // Event listeners para las tarjetas del equipo
    teamCards.forEach((card, index) => {
      const imageContainer = card.querySelector(".team-image-container");
      const banner = card.querySelector(".team-banner");

      // Click on image container
      if (imageContainer) {
        imageContainer.addEventListener("click", function (e) {
          // No hacer toggle si se hace click en el botón "Ver más"
          const viewMoreBtn = (e.target as HTMLElement).closest('.view-more-btn');
          if (viewMoreBtn) {
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          toggleTeamCard(card);
        });

        // Always add cursor pointer for mobile
        (imageContainer as HTMLElement).style.cursor = "pointer";
      }

      // Click on banner
      if (banner) {
        banner.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          toggleTeamCard(card);
        });

        // Always add cursor pointer for mobile
        (banner as HTMLElement).style.cursor = "pointer";
      }
    });

    // Event listeners para cerrar modal
    document.addEventListener("click", function (e) {

      // Cerrar modal
      if (
        (e.target as HTMLElement).closest(".team-modal-close") ||
        (e.target as HTMLElement).classList.contains("team-modal-backdrop")
      ) {
        closeDetailModal();
        return;
      }

      // Close overlay when clicking outside (only on mobile screens)
      if (window.innerWidth > 768) return; // Only on mobile

      const target = e.target as HTMLElement;
      const clickedCard = target?.closest(".team-card");
      if (!clickedCard) {
        teamCards.forEach((card) => {
          card.classList.remove("active");
        });
      }
    });

    // Cerrar modal con Escape
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal?.classList.contains("is-open")) {
        closeDetailModal();
      }
    });

  });
</script>

                                </svg>
                                Gerente Financiera
                            </p>
                        </div>
                    </div>
                    
                    <!-- Daniela Arango Sánchez - Gerente Administrativo -->
                    <div class="team-card centered">
                        <div class="team-image-container">
                            <img src={`${import.meta.env.BASE_URL}img/equipo/Daniela-Arango.webp`} alt="Daniela Arango Sánchez" class="team-image">

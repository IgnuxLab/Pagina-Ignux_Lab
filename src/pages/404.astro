---
import Layout from '../layouts/Layout.astro';
import { ROUTES } from '../config/routes';

// Importar estilos del sitio
import '../assets/styles/general.css';
---

<Layout 
  title={ROUTES.NOT_FOUND.title}
>
  <div class="page-container">
    <!-- Separador superior -->
    <div class="section-separator"></div>
    
    <div class="section-container">
      <div class="error-page section-spacing">
        <!-- Contenido principal centrado -->
        <div class="error-content-wrapper">
          <!-- Número 404 -->
          <div class="error-number" data-aos="fade-up">
            <span class="error-404">404</span>
          </div>

          <!-- Mensaje principal -->
          <div class="error-message" data-aos="fade-up" data-aos-delay="200">
            <h1 class="error-title">Página no encontrada</h1>
            <p class="error-description">
              Lo sentimos, la página que buscas no existe o ha sido movida.
            </p>
          </div>

          <!-- Botones de acción -->
          <div class="error-actions" data-aos="fade-up" data-aos-delay="400">
            <a href="/" class="btn-home">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2"/>
                <polyline points="9,22 9,12 15,12 15,22" stroke="currentColor" stroke-width="2"/>
              </svg>
              Volver al Inicio
            </a>
            
            <a href="/solutions" class="btn-solutions">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2"/>
                <line x1="9" y1="9" x2="15" y2="15" stroke="currentColor" stroke-width="2"/>
                <line x1="15" y1="9" x2="9" y2="15" stroke="currentColor" stroke-width="2"/>
              </svg>
              Ver Soluciones
            </a>
          </div>

          <!-- Enlaces rápidos -->
          <div class="quick-links" data-aos="fade-up" data-aos-delay="600">
            <p class="quick-links-title">O explora nuestras secciones:</p>
            <div class="links-grid">
              <a href="/about" class="quick-link">Sobre Nosotros</a>
              <a href="/news" class="quick-link">Noticias</a>
              <a href="/contact" class="quick-link">Contacto</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Separador inferior -->
    <div class="section-separator"></div>
  </div>
</Layout>

<style>
  /* ===== PÁGINA 404 SIMPLE Y ELEGANTE ===== */
  
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
  }

  .error-content-wrapper {
    max-width: 600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* ===== NÚMERO 404 ===== */
  .error-number {
    margin-bottom: 1rem;
  }

  .error-404 {
    font-family: var(--font-display);
    font-size: clamp(6rem, 12vw, 8rem);
    font-weight: 700;
    color: transparent;
    background: linear-gradient(135deg, var(--color-accent), var(--color-orange));
    -webkit-background-clip: text;
    background-clip: text;
    line-height: 1;
    display: block;
  }

  /* ===== MENSAJE ===== */
  .error-message {
    margin-bottom: 2rem;
  }

  .error-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: var(--color-accent);
    margin: 0 0 1rem 0;
    font-weight: 600;
    background: linear-gradient(135deg, var(--color-accent), var(--color-orange));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .error-description {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    line-height: 1.6;
    max-width: 500px;
  }

  /* ===== BOTONES ===== */
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .btn-home,
  .btn-solutions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    font-family: var(--font-body);
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .btn-home {
    background: linear-gradient(135deg, var(--color-accent), var(--color-orange));
    color: white;
  }

  .btn-home:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(216, 35, 255, 0.3);
  }

  .btn-solutions {
    background: transparent;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn-solutions:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-2px);
  }

  /* ===== ENLACES RÁPIDOS ===== */
  .quick-links {
    margin-top: 1rem;
  }

  .quick-links-title {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 1rem 0;
  }

  .links-grid {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .quick-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .quick-link:hover {
    background: rgba(216, 35, 255, 0.1);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .error-content-wrapper {
      gap: 1.5rem;
      padding: 0 1rem;
    }

    .error-actions {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .btn-home,
    .btn-solutions {
      width: 100%;
      max-width: 250px;
      justify-content: center;
    }

    .links-grid {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .quick-link {
      width: 100%;
      max-width: 200px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .error-404 {
      font-size: clamp(4rem, 15vw, 6rem);
    }

    .error-title {
      font-size: clamp(1.5rem, 5vw, 2rem);
    }

    .error-description {
      font-size: clamp(1rem, 3vw, 1.1rem);
    }
  }
</style>

<script>
  // Script simple para la página 404
  
  // Agregar clase de error al body
  document.body.classList.add('error-404');
  
  // Efecto de hover suave en los enlaces rápidos
  document.querySelectorAll('.quick-link').forEach(link => {
    link.addEventListener('mouseenter', () => {
      (link as HTMLElement).style.transform = 'translateY(-2px)';
    });
    
    link.addEventListener('mouseleave', () => {
      (link as HTMLElement).style.transform = 'translateY(0)';
    });
  });
  
  // Animación sutil para los botones
  document.querySelectorAll('.btn-home, .btn-solutions').forEach(btn => {
    btn.addEventListener('mouseenter', () => {
      (btn as HTMLElement).style.transform = 'translateY(-2px)';
    });
    
    btn.addEventListener('mouseleave', () => {
      (btn as HTMLElement).style.transform = 'translateY(0)';
    });
  });
</script>

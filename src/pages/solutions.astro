---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../assets/styles/components/solutions-page.css';
---

<Layout title="Soluciones">
	<div class="page-container">
		<Header />
		
		<main class="solutions-main">
			<section class="hero-banner">
				<div class="hero-content">
					<h1 class="hero-title">Nuestras Soluciones</h1>
					<div class="breadcrumb">
						<a href={`${import.meta.env.BASE_URL}`} class="breadcrumb-link">Inicio</a>
						<span class="separator">/</span>
						<span class="breadcrumb-active">Soluciones</span>
					</div>
				</div>
			</section>

			<!-- Contenido principal de soluciones -->
			<section class="solutions-content">
				<div class="container">
					<!-- Introducción -->
					<div class="solutions-intro">
						<p class="solutions-vision">
							Tres laboratorios, una sola visión: <strong>crear, aprender y transformar</strong> a través de la innovación
						</p>
					</div>

					<!-- Grid de Laboratorios -->
					<div class="labs-grid">
						<!-- Laboratorio de Formación -->
						<div class="lab-card formacion">
							<img class="lab-gif" src={`${import.meta.env.BASE_URL}img/icons/lab-para-la-formacion.gif`} alt="Laboratorio de Formación" />
							<h3 class="lab-title">Laboratorio de Formación</h3>
							<p class="lab-subtitle">Con más de 25 años de experiencia, creamos experiencias educativas que transforman.</p>
							<p class="lab-description">
								Desarrollamos contenidos en habilidades digitales, desarrollo personal y profesional, y acompañamos a instituciones en el diseño y virtualización de procesos formativos en modalidad virtual, mixta y presencial.
							</p>
							<p class="lab-approach">
								Nuestro enfoque es activo y vivencial: impulsa la autonomía, el pensamiento crítico y un aprendizaje realmente significativo.
							</p>
						</div>

						<!-- Laboratorio de Proyectos -->
						<div class="lab-card proyectos">
							<img class="lab-gif" src={`${import.meta.env.BASE_URL}img/icons/lab-de-proyectos.gif`} alt="Laboratorio de Proyectos" />
							<h3 class="lab-title">Laboratorio de Proyectos</h3>
							<p class="lab-subtitle">Convertimos ideas y necesidades en soluciones estratégicas e innovadoras.</p>
							<p class="lab-description">
								Diseñamos proyectos a la medida, combinando creatividad y análisis para responder a los objetivos de cada cliente. Definimos metas claras, optimizamos recursos y aseguramos procesos viables y sostenibles.
							</p>
							<p class="lab-approach">
								Nuestro compromiso es dar dirección, minimizar riesgos y garantizar resultados consistentes en cada fase del proyecto.
							</p>
						</div>

						<!-- Laboratorio Creativo -->
						<div class="lab-card creativo">
							<img class="lab-gif" src={`${import.meta.env.BASE_URL}img/icons/lab-creativo.gif`} alt="Laboratorio Creativo" />
							<h3 class="lab-title">Laboratorio Creativo</h3>
							<p class="lab-subtitle">Un espacio para dar vida a las ideas, desde marketing digital, diseño gráfico y producción audiovisual, hasta narrativas inmersivas y formatos experimentales.</p>
							<p class="lab-description">
								Imaginamos, diseñamos y producimos soluciones creativas que van de lo convencional a lo inesperado, siempre alineadas con los objetivos de cada organización.
							</p>
							<p class="lab-approach">
								Somos un aliado transversal para materializar cualquier reto comunicativo o expresivo.
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</div>
</Layout>

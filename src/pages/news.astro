---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoHero from '../components/VideoHero.astro';
import NewsGrid from '../components/NewsGrid.astro';

import '../assets/styles/components/news-page.css';
---

<Layout title="Noticias">
	<div class="page-container">
		<Header />
		
		<main class="news-main">
			<section class="hero-banner">
				<div class="hero-content">
					<h1 class="hero-title">Noticias</h1>
					<div class="breadcrumb">
						<a href={`${import.meta.env.BASE_URL}`} class="breadcrumb-link">Inicio</a>
						<span class="separator">/</span>
						<span class="breadcrumb-active">Noticias</span>
					</div>
				</div>
			</section>
			
			<!-- Video Hero Decorativo -->
			<VideoHero />
			<div class="section-separator"></div>
			
			<!-- Grid de Noticias -->
			<NewsGrid />
			<div class="section-separator"></div>
		</main>

		<Footer />
	</div>
</Layout>

<script type="module" src={`${import.meta.env.BASE_URL}scripts/news.js`}></script>

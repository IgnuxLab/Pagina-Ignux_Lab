---
import '@/assets/styles/components/about-us.css';
---

<section class="about-us section-spacing section-depth" data-aos="fade-up">
    <div class="about-container">
        <!-- Descripción principal -->
        <div class="intro-section" data-aos="fade-in" data-aos-delay="200">
            <div class="intro-content">
                <!-- Esquinas decorativas -->
                <div class="corner-top-left" data-aos="fade-down-right" data-aos-delay="400"></div>
                <div class="corner-top-right" data-aos="fade-down-left" data-aos-delay="500"></div>
                <div class="corner-bottom-left" data-aos="fade-up-right" data-aos-delay="600"></div>
                <div class="corner-bottom-right" data-aos="fade-up-left" data-aos-delay="700"></div>             
                <div class="intro-title-container" data-aos="fade-down" data-aos-delay="300">
                    <h2 class="intro-main-title">Sobre Nosotros</h2>
                    <p class="intro-subtitle">Quiénes somos y qué nos mueve</p>
                    <div class="title-accent-line" data-aos="slide-right" data-aos-delay="600"></div>
                </div>
                <div class="intro-text" data-aos="fade-up" data-aos-delay="500">
                    <p class="main-description">
                        Somos <strong>IGNUX Lab</strong>, una empresa de integración digital con la experiencia y el conocimiento necesarios para conectar la creatividad, la innovación y la tecnología. Nuestro propósito es ofrecer soluciones a la medida de nuestros clientes, transformando lo cotidiano en experiencias extraordinarias que generen un impacto positivo en la sociedad.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

---
import '@/assets/styles/components/about-us.css';
---

<!-- Preload de la imagen principal del equipo -->
<link rel="preload" as="image" href="/img/equipo/equipo_ai.webp" fetchpriority="high">

<section class="about-us section-spacing section-depth">
    <div class="about-container">
        <!-- Encabezado principal con título integrado -->
        <div class="intro-section">
            <div class="header-content">
                <!-- Esquinas decorativas -->
                <div class="corner-top-left"></div>
                <div class="corner-top-right"></div>
                <div class="corner-bottom-left"></div>
                <div class="corner-bottom-right"></div>
                
                <div class="header-title-container">
                    <h3 class="main-title">Sobre Nosotros</h3>
                    <div class="title-accent-line"></div>
                </div>
            </div>
        </div>

        <!-- Contenido principal organizado -->
        <div class="content-grid">
            <!-- Quiénes somos -->
            <div class="content-card">
                <div class="card-content">
                    <h3 class="card-title">Quiénes Somos</h3>
                    <p class="card-description">
                        Somos <strong>IGNUX Lab</strong>, una empresa de integración digital con la experiencia y el conocimiento necesarios para conectar la creatividad, la innovación y la tecnología.
                    </p>
                </div>
            </div>

            <!-- Qué nos mueve -->
            <div class="content-card">
                <div class="card-content">
                    <h3 class="card-title">Qué Nos Mueve</h3>
                    <p class="card-description">
                        Nuestro propósito es ofrecer soluciones a la medida de nuestros clientes, transformando lo cotidiano en experiencias extraordinarias que generen un impacto positivo en la sociedad.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

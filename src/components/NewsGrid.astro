---
import newsData from '@/data/news.json';
import '@/assets/styles/components/news-grid.css';

const { featured, recent } = newsData;

const formatDate = (dateString: string) => {
	const date = new Date(dateString);
	return date.toLocaleDateString('es-ES', { 
		year: 'numeric', 
		month: 'long', 
		day: 'numeric' 
	});
};
---

<section class="news-grid-section section-spacing section-depth" data-aos="fade-up" data-aos-duration="1000" data-aos-easing="ease-out-cubic">
    <div class="news-container">
        <div class="section-header" data-aos="fade-down" data-aos-delay="150" data-aos-duration="800" data-aos-easing="ease-out-cubic">
            <h2 class="section-title">Últimas Noticias</h2>
            <p class="section-subtitle">
                Mantente al día con nuestros proyectos e innovaciones más recientes
            </p>
        </div>
        
        <div class="news-grid" data-aos="fade-up" data-aos-delay="300" data-aos-duration="1000" data-aos-easing="ease-out-cubic">
            <!-- Noticia Destacada Original -->
            <article class="news-card featured" data-aos="slide-up" data-aos-delay="450" data-aos-duration="800" data-aos-easing="ease-out-cubic">
                <div class="news-image" {...(featured.video ? { 'data-open-video': true, 'data-video-src': featured.video } : {})}>
                    <img src={`${import.meta.env.BASE_URL}img/${featured.image}`} alt={featured.title} loading="lazy" />
                    {featured.video && (
                        <button type="button" class="play-overlay" data-open-video data-video-src={featured.video} aria-label="Reproducir video de lanzamiento">
                            <span class="play-icon">▶</span>
                        </button>
                    )}
                    <div class="news-category">{featured.category}</div>
                </div>
                <div class="news-content">
                    <div class="news-meta">
                        <span class="news-date">{formatDate(featured.date)}</span>
                        <span class="news-author">{featured.author}</span>
                    </div>
                    <h3 class="news-title">{featured.title}</h3>
                    <p class="news-excerpt">
                        {featured.excerpt}
                    </p>
                    <div class="news-tags">
                        {featured.tags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                </div>
            </article>

            {featured.video && (
                <div id="videoModal" class="video-modal" aria-hidden="true">
                    <div class="video-modal-backdrop" data-close-video></div>
                    <div class="video-modal-dialog" role="dialog" aria-modal="true" aria-label="Reproductor de video">
                        <button class="video-modal-close" type="button" data-close-video aria-label="Cerrar">×</button>
                        <div class="video-modal-header">
                            <h3 class="video-modal-title">{featured.title}</h3>
                            <div class="video-modal-meta">
                                <span class="video-date">{formatDate(featured.date)}</span>
                                <span class="video-author">Por {featured.author}</span>
                            </div>
                        </div>
                        <div class="video-modal-content">
                            <video 
                                id="videoModalPlayer" 
                                controls={featured.videoConfig?.controls !== false}
                                preload="metadata" 
                                playsinline 
                                muted={featured.videoConfig?.muted !== false}
                                autoplay={featured.videoConfig?.autoplay === true}
                                poster={`${import.meta.env.BASE_URL}img/${featured.image}`}
                            ></video>
                        </div>
                        <div class="video-modal-footer">
                            <p class="video-description">{featured.content}</p>
                            <div class="video-tags">
                                {featured.tags.map((tag: string) => (
                                    <span class="video-tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            )}

            <!-- Noticias Recientes -->
            {recent.map((news: any, index: number) => (
                <article class="news-card" data-aos="slide-up" data-aos-delay={600 + (index * 80)} data-aos-duration="800" data-aos-easing="ease-out-cubic">
                    <div class="news-image" {...(news.type === 'instagram_post' ? { 'style': 'cursor: pointer;' } : {})} 
                         {...(news.type === 'instagram_post' ? { 'onclick': `window.open('${news.instagram_url}', '_blank', 'noopener,noreferrer')` } : {})}>
                        <img src={`${import.meta.env.BASE_URL}img/${news.image}`} alt={news.title} loading="lazy">
                        <div class="news-category">{news.category}</div>
                        {news.type === 'instagram_post' && (
                            <div class="instagram-overlay">
                                <span class="instagram-icon">📷</span>
                                <span class="instagram-text">Ver en Instagram</span>
                            </div>
                        )}
                    </div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">{formatDate(news.date)}</span>
                            <span class="news-author">{news.author}</span>
                        </div>
                        <h3 class="news-title">{news.title}</h3>
                        <p class="news-excerpt">
                            {news.excerpt}
                        </p>
                        <div class="news-tags">
                            {news.tags.map((tag: string) => (
                                <span class="tag">{tag}</span>
                            ))}
                        </div>
                        {news.type === 'instagram_post' && (
                            <a href={news.instagram_url} target="_blank" rel="noopener noreferrer" class="instagram-link">
                                <span class="instagram-link-icon">📱</span>
                                <span>Ver post en Instagram</span>
                                <span class="external-icon">↗</span>
                            </a>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<style></style>

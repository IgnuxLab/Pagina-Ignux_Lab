---
import '@/assets/styles/components/clients.css';

const baseUrl = import.meta.env.BASE_URL;
---

<section class="clients section-spacing section-depth" data-aos="fade-up">
    <div class="section-container">
        <!-- Header de la sección -->
        <div class="clients-header" data-aos="fade-down" data-aos-delay="200">
            <div class="clients-header-content">
                <h2 class="clients-title" data-aos="fade-right" data-aos-delay="300">Nuestra experiencia</h2>
                <p class="clients-description" data-aos="fade-left" data-aos-delay="400">
                    A lo largo de 25 años IGNUX LAB ha trabajado con diferentes aliados, dentro de los cuales están
                </p>
            </div>
        </div>
        
        <!-- Carrusel infinito de clientes -->
        <div class="clients-carousel" data-aos="fade-up" data-aos-delay="500">
            <div class="carousel-track" id="carouselTrack">
                <!-- Primera serie de slides -->
                <div class="carousel-slide" data-aos="zoom-in" data-aos-delay="600">
                    <img src={`${baseUrl}img/clientes/client-1.webp`} alt="Cliente 1" loading="lazy">
                </div>
                <div class="carousel-slide" data-aos="zoom-in" data-aos-delay="650">
                    <img src={`${baseUrl}img/clientes/client-2.webp`} alt="Cliente 2" loading="lazy">

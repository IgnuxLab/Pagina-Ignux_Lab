---
import '@/assets/styles/components/header.css';
---

<header class="header">
  <div class="header-container">
    <div class="logo-container">
      <a href={import.meta.env.BASE_URL} class="logo-link">
        <img src={`${import.meta.env.BASE_URL}img/logo.webp`} alt="IGNUXLab Logo" class="logo-image">
      </a>
    </div>
    
    <nav class="navigation" id="navigation">
      <ul class="nav-list">
        <li class="nav-item">
          <a href={import.meta.env.BASE_URL} class="nav-link" data-page="home">Inicio</a>
        </li>
        <li class="nav-item">
          <a href={`${import.meta.env.BASE_URL}about`} class="nav-link" data-page="about">Sobre nosotros</a>
        </li>
        <li class="nav-item">
          <a href={`${import.meta.env.BASE_URL}solutions`} class="nav-link" data-page="solutions">Soluciones</a>
        </li>
        <li class="nav-item">
          <a href={`${import.meta.env.BASE_URL}news`} class="nav-link" data-page="news">Noticias</a>
        </li>
        <li class="nav-item">
          <a href={`${import.meta.env.BASE_URL}contact`} class="nav-link" data-page="contact">Cont&aacute;ctanos</a>
        </li>
      </ul>
    </nav>
    
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
  </header>
  
  <script type="module" src={`${import.meta.env.BASE_URL}scripts/header.js`}></script>

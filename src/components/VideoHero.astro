---
// El componente ahora es solo para mostrar el video sin datos adicionales
---

<section class="video-hero section-spacing-compact section-depth" data-aos="fade-up" data-aos-duration="1200" data-aos-easing="ease-out-cubic">
    <!-- Video principal -->
    <video 
        id="heroVideo"
        class="hero-video" 
        controls
        preload="metadata"
        poster="https://ignuxlab.com/video-ignux/lanzamiento-ignuxlab-poster.jpg"
        data-start-time="12"
        data-aos="zoom-in" 
        data-aos-duration="1500"
        data-aos-delay="200"
        data-aos-easing="ease-out-cubic">
        <source src="https://ignuxlab.com/video-ignux/lanzamiento-ignuxlab.mp4#t=12" type="video/mp4">
        Tu navegador no soporta la reproducción de video.
    </video>
    
    <!-- Overlay -->
    <div class="hero-overlay" data-aos="fade-in" data-aos-delay="600" data-aos-duration="1000" data-aos-easing="ease-out-cubic"></div>
</section>

<style>
/* ===== VIDEO HERO  */

.video-hero {
    position: relative;
    width: calc(100% - 2rem);
    height: auto;
    min-height: 500px;
    max-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem auto;
    border-radius: 25px;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    filter: blur(4px);
    animation: heroEntrance 2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Video principal */
.hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    border-radius: 25px;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Overlay sutil para mejorar el diseño */
.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        135deg,
        rgba(22, 20, 38, 0.1) 0%,
        rgba(52, 46, 89, 0.05) 50%,
        rgba(22, 20, 38, 0.1) 100%
    );
    z-index: 2;
    border-radius: 25px;
    pointer-events: none;
    opacity: 0;
    animation: overlayFadeIn 2.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.5s forwards;
}

/* Animación para el overlay */
@keyframes overlayFadeIn {
    0% {
        opacity: 0;
    }
    100% {
        opacity: 1;
    }
}

/* Animación de entrada */
@keyframes heroEntrance {
    0% {
        transform: scale(0.95) translateY(20px);
        opacity: 0;
        filter: blur(4px);
    }
    50% {
        transform: scale(0.98) translateY(10px);
        opacity: 0.6;
        filter: blur(2px);
    }
    100% {
        transform: scale(1) translateY(0);
        opacity: 1;
        filter: blur(0px);
    }
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 1024px) {
    .video-hero {
        min-height: 400px;
        max-height: 500px;
        border-radius: 20px;
    }
    
    .hero-video,
    .hero-overlay {
        border-radius: 20px;
    }
}

@media (max-width: 768px) {
    .video-hero {
        width: calc(100% - 1rem);
        min-height: 350px;
        max-height: 450px;
        margin: 0.5rem auto;
        border-radius: 15px;
    }
    
    .hero-video,
    .hero-overlay {
        border-radius: 15px;
    }
}

@media (max-width: 480px) {
    .video-hero {
        width: calc(100% - 0.5rem);
        min-height: 300px;
        max-height: 400px;
        border-radius: 12px;
    }
    
    .hero-video,
    .hero-overlay {
        border-radius: 12px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement;
    let hasPlayed = false;
    
    if (heroVideo) {
        // Configurar el video para mostrar el frame del segundo 12
        heroVideo.addEventListener('loadedmetadata', function() {
            if (!hasPlayed) {
                heroVideo.currentTime = 12;
            }
        });
        
        // Cuando el usuario hace clic en play, iniciar desde el principio
        heroVideo.addEventListener('play', function() {
            if (!hasPlayed) {
                heroVideo.currentTime = 0;
                hasPlayed = true;
            }
        });
        
        // Reset cuando el video termina o se pausa por mucho tiempo
        heroVideo.addEventListener('ended', function() {
            hasPlayed = false;
            setTimeout(() => {
                if (heroVideo.paused) {
                    heroVideo.currentTime = 12;
                }
            }, 1000);
        });
        
        // Si el video se pausa y regresa al inicio, resetear
        heroVideo.addEventListener('pause', function() {
            setTimeout(() => {
                if (heroVideo.currentTime === 0 && !hasPlayed) {
                    heroVideo.currentTime = 12;
                }
            }, 500);
        });
    }
});
</script>

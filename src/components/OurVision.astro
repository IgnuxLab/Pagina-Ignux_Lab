---
import '@/assets/styles/components/our-vision.css';
---

<section class="our-vision section-spacing section-depth" data-aos="fade-up">
    <div class="vision-container">
        <!-- Header de la sección -->
        <div class="vision-header" data-aos="fade-down" data-aos-delay="200">
            <h2 class="section-main-title">Nuestra Visión</h2>
            <p class="section-subtitle">Construyendo el futuro digital de América Latina</p>
        </div>
        

        
        <!-- Contenido principal -->
        <div class="vision-content" data-aos="fade-in" data-aos-delay="400">
            <!-- Texto de la visión -->
            <div class="vision-text">
                <div class="vision-text-header" data-aos="fade-right" data-aos-delay="600">
                    <h3 class="vision-title">Visión 2030</h3>
                    <h4 class="vision-subtitle">¿Hacia dónde vamos?</h4>
                    <div class="vision-accent-line" data-aos="slide-right" data-aos-delay="800"></div>
                </div>
                
                <div class="vision-description-container" data-aos="fade-left" data-aos-delay="700">
                    <p class="vision-description">
                        Para el año <strong>2030</strong>, seremos un referente social en la construcción de conocimiento y la generación de valor que impulse el desarrollo en América Latina.
                    </p>
                    <p class="vision-description-secondary">
                        Visualizamos un futuro en el que lo digital no solo soluciona problemas, sino que también despierta emociones y transforma vidas a través de la innovación tecnológica y la creatividad humana.
                    </p>
                </div>
                
                <!-- Elementos de la visión -->
                <div class="vision-elements">
                    <div class="vision-element" data-aos="zoom-in" data-aos-delay="900">
                        <div class="element-icon">🚀</div>
                        <div class="element-content">
                            <h5 class="element-title">Innovación Social</h5>
                            <p class="element-description">Crear soluciones que impacten positivamente en la sociedad</p>
                        </div>
                    </div>
                    
                    <div class="vision-element" data-aos="zoom-in" data-aos-delay="1000">
                        <div class="element-icon">🌍</div>
                        <div class="element-content">
                            <h5 class="element-title">Impacto Regional</h5>
                            <p class="element-description">Ser referente en el desarrollo de América Latina</p>
                        </div>
                    </div>
                    
                    <div class="vision-element" data-aos="zoom-in" data-aos-delay="1100">
                        <div class="element-icon">💡</div>
                        <div class="element-content">
                            <h5 class="element-title">Transformación Digital</h5>
                            <p class="element-description">Revolucionar la forma en que se construye el conocimiento</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Footer de la visión -->
        <div class="vision-footer" data-aos="fade-up" data-aos-delay="1200">
            <p class="vision-motto">"Transformando el presente, construyendo el futuro"</p>
        </div>
    </div>
</section>
